#!/bin/sh

router_model=$(ubus call system board | jsonfilter -e "@['board_name']")

if [ "$(uci -q get xsdk.@factory[0].init)" != "1" ]
then

	# add wan ports to various supported models, if no model is found we skip the placement.
	[[ "$router_model" = "glinet,gl-mt6000" ]] && uci add_list network.@device[0].ports='eth1'
	[[ "$router_model" = "zyxel,ex5601-t0-ubootmod" ]] && uci add_list network.@device[0].ports='wan'
	[[ "$router_model" = "glinet,gl-be14000" ]] && uci add_list network.@device[0].ports='wan' && uci add_list network.@device[0].ports='sfp'
	uci set network.@device[0].bridge_empty='1'

	vlanlist="50 51 52 90 133 178 179 62"

	if [ "$router_model" = "glinet,gl-mt6000" ]
	then

		port_map="eth1 lan1 lan2 lan3 lan4 lan5"
		uci add network bridge-vlan
		uci set network.@bridge-vlan[-1].vlan='169'
		uci add_list network.@bridge-vlan[-1].ports='eth1:t'

		for tagged_vlan in $vlanlist; do
			uci add network bridge-vlan
			uci set network.@bridge-vlan[-1].vlan="$tagged_vlan"
			uci set network.@bridge-vlan[-1].device='br-lan'
			for dsa_port in $port_map; do
				uci add_list network.@bridge-vlan[-1].ports="${dsa_port}:t"
			done
		done

		uci add network bridge-vlan
		uci set network.@bridge-vlan[-1].vlan='10'
		uci set network.@bridge-vlan[-1].device='br-lan'
		uci add_list network.@bridge-vlan[-1].ports='lan5:t'

	elif [ "$router_model" = "glinet,gl-be14000" ]
	then

		port_map="sfp wan lan2 lan3 lan4 lan5 lan6 lan7 lan8"
                uci add network bridge-vlan
                uci set network.@bridge-vlan[-1].vlan='169'
		uci set network.@bridge-vlan[-1].device='br-lan'
                uci add_list network.@bridge-vlan[-1].ports='sfp:t'
		uci add_list network.@bridge-vlan[-1].ports='wan:t'

                for tagged_vlan in $vlanlist; do
                        uci add network bridge-vlan
			uci set network.@bridge-vlan[-1].device="br-lan"
                        uci set network.@bridge-vlan[-1].vlan="$tagged_vlan"
                        for dsa_port in $port_map; do
                                uci add_list network.@bridge-vlan[-1].ports="${dsa_port}:t"
                        done
                done

		uci add network bridge-vlan
		uci set network.@bridge-vlan[-1].vlan='10'
		uci set network.@bridge-vlan[-1].device="br-lan"
		uci add_list network.@bridge-vlan[-1].ports='lan8:t'
	elif [ "$router_model" = "zyxel,ex5601-t0-ubootmod" ]
	then

	 	port_map="wan lan1 lan2 lan3 lan4"
                uci add network bridge-vlan
		uci set network.@bridge-vlan[-1].device='br-lan'
                uci set network.@bridge-vlan[-1].vlan='169'
                uci add_list network.@bridge-vlan[-1].ports='wan:t'

                for tagged_vlan in $vlanlist; do
                        uci add network bridge-vlan
			uci set network.@bridge-vlan[-1].device='br-lan'
                        uci set network.@bridge-vlan[-1].vlan="$tagged_vlan"
                        for dsa_port in $port_map; do
                                uci add_list network.@bridge-vlan[-1].ports="${dsa_port}:t"
                        done
                done

		uci add network bridge-vlan
		uci set network.@bridge-vlan[-1].device='br-lan'
		uci set network.@bridge-vlan[-1].vlan='10'
		uci add_list network.@bridge-vlan[-1].ports='lan4:t'

	fi

	uci commit network
fi
exit 0


